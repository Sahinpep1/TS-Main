function ValidateControl(source, args) {
    var validatedControl = $('#' + source.attributes['data-val-controltovalidate'].value);

    if (/\S/.test(args.Value)) { // string is not empty and not just whitespace
        validatedControl.removeClass('validation-error');
        //args.IsValid = true;
    }
    else {
        validatedControl.addClass('validation-error');
        //args.IsValid = false;
    }
}

//Şimdilik kullanılmıyor, kullanılması için Control.InvalidStyle verilmeli.
function ValidateTelerikControl(source, args) {
    var validatedTelerikControl = $find(source.attributes['data-val-controltovalidate'].value); //telerik

    if (validatedTelerikControl) {
        if (/\S/.test(args.Value)) { // string is not empty and not just whitespace
            validatedTelerikControl._invalid = false;
            validatedTelerikControl.updateCssClass();
            args.IsValid = true;
        }
        else {
            validatedTelerikControl._invalid = true;
            validatedTelerikControl.updateCssClass();
            args.IsValid = false;
        }
    }
}

// Bu kısım, RadAjaxManager içerisindeki herhangi bir control'un, postback yaptırıp yaptırmayacağını belirliyor.
// Herhangi bir kontrol postback yaptırmın isteniyorsa, PostBackControlArray dizisine ID'si eklenmelidir..
var DoPostbackControl = false;
var divHeight = 500;
var SkipMenuItemDisable = false;

function MainAjaxManagerRequestStart(sender, eventArgs) {
    if (DoPostbackControl)
    { eventArgs.set_enableAjax(false); }
    DoPostbackControl = false;
}

function DoPostbackFunction(sender, args, skipMenuDisable) {

    if (!sender || !sender.constructor) {
        DoPostbackControl = true;
    } else if (sender.constructor.getName() == "Telerik.Web.UI.RadToolBar") {
        SkipMenuItemDisable = skipMenuDisable;
        var button = args.get_item();
        var btnValue = button.get_value();
        if (btnValue != "Search" && btnValue != "QuickSearch") {

            /// Menu items disable process ///
            if (SkipMenuItemDisable == undefined || SkipMenuItemDisable == false)
                sender.get_items().forEach(function (item) {
                    item.set_enabled(false);
                });
            /// Menu items disable process ///

            if (btnValue == "Clear")
                ReloadPage();
            else {
                DoPostbackControl = true;
            }
        }
        SkipMenuItemDisable = false;
        //} else if (sender.constructor.getName() == 'Telerik.Web.UI.RadSearchBox') {
        //    //RadSearchBox için geliyor
        //    DoPostbackControl = true;
    } else {
        DoPostbackControl = true;
    }
}

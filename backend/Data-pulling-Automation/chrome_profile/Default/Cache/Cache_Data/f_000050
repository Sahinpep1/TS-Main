function ReloadPage() {
    //Bir sayfayı clientside temizlemek için. btnNew'lerde kullanılmak için tasarlandı.
    //var fullURL = location.protocol + '//' + location.hostname + (location.port ? ":" + location.port : "") + location.pathname + (location.search ? location.search : "");
    var mode = getQueryParameter("mode");
    window.location.href = location.protocol + '//' + location.hostname + (location.port ? ":" + location.port : "") + location.pathname + (mode ? "?mode=" + mode : "");
    return false;
}


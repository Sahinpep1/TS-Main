function viewport() {
    var e = window
    , a = 'inner';
    if (!('innerWidth' in window)) {
        a = 'client';
        e = document.documentElement || document.body;
    }
    return { width: e[a + 'Width'], height: e[a + 'Height'] }
}

function resizeContentPlaceHolderDivison() {
    //divHeight = screen.availHeight - ($.browser.webkit ? 111 : 150);
    divHeight = viewport().height;
    $('#ContentPlaceHolderDivison').height(divHeight);
    $('#divMainContent').height(divHeight - 64);
    //$('#hdnHeight').val(divHeight - 64);
}

// Telerik gridlerinde Edit Mode olarak Popup kullanıyorsak,
// Popup'ı ekranda ortalamak için OnPopUpShowing eventinde bunu çağırmamız yeterli.
// Popup'ın Width ve Height değerleri önceden verilmiş olmalı.
function CenterPopup(sender, e) {
    try {
        var vp = viewport();
        var popUp = e.get_popUp();
        var popUpWidth = parseInt(popUp.style.width);
        var popUpHeight = parseInt(popUp.style.height);

        popUp.style.top = Math.floor((vp.height - popUpHeight) / 2) + "px";
        popUp.style.left = Math.floor((vp.width - popUpWidth) / 2) + "px";
        popUp.style.position = "fixed";

    } catch (ex) {
        //alert(ex);
    }
}

var currentLoadingPanel = null;
var contentPlaceHolderDivisonID = 'ContentPlaceHolderDivison';
$(function () {
    Sys.WebForms.PageRequestManager.getInstance().add_beginRequest(BeginRequestHandler);
    Sys.WebForms.PageRequestManager.getInstance().add_endRequest(EndRequestHandler);
});

//Samet buldu: http://disturbedbuddha.wordpress.com/2007/12/03/maintain-scroll-position-after-asynchronous-postback/
var divMainContentScrollTop;

function BeginRequestHandler(sender, args) {
    currentLoadingPanel = $find('MainLoadingPanel');
    if (currentLoadingPanel)
        currentLoadingPanel.show(contentPlaceHolderDivisonID);

    var divMainContent = $('#divMainContent');
    if (divMainContent)
        divMainContentScrollTop = divMainContent.scrollTop();
}

function EndRequestHandler(sender, args) {
    if (currentLoadingPanel)
        currentLoadingPanel.hide(contentPlaceHolderDivisonID);

    var divMainContent = $('#divMainContent');
    if (divMainContent) {
        divMainContent.height(divHeight - 64);
        divMainContent.scrollTop(divMainContentScrollTop);
    }
}


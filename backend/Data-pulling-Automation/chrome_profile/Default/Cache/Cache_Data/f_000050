var confirmWindowId = "ctl00_confirmWindow";
var btnYesId = "btnYes";
var btnNoId = "btnNo";
var lblConfirmId = "lblConfirm";

//Custom RadWindow Confirm
function CustomRadWindowConfirm(sender, args, cid, text) {
    //Open the window
    $find(confirmWindowId).show();

    // Already added events has been removing before inserting new one
    // to prevent the duplication of same event
    $find(btnYesId).get_events()._list.clicked = null;
    $find(btnNoId).get_events()._list.clicked = null;

    $find(btnYesId).add_clicked(function (button, args) { YesClicked(button, args, cid) });
    $find(btnNoId).add_clicked(NoClicked);

    $find(btnYesId).focus();

    document.getElementById('lblConfirm').innerHTML = text;


    //Cancel the postback
    args.set_cancel(true);
}

function YesClicked(sender, args, cid) {
    $find(confirmWindowId).close();
    $find(cid).click();
}

function NoClicked(sender, args) {
    $find(confirmWindowId).close();
}

function CustomRadWindowConfirmToolbarItem(sender, args, cid, text, toolbarItemValue) {

    var toolBar = sender;
    var toolbarItem = args.get_item();

    if (toolbarItem.get_value() == toolbarItemValue && toolBar.get_attributes().getAttribute("DisableConfirm") == undefined) {

        //Open the window
        $find(confirmWindowId).show();

        var x = function (button, args) { YesClickedToolbarItem(button, args, toolBar.get_id(), toolbarItem.get_value()) };

        $find(btnYesId).remove_clicked(x);
        $find(btnNoId).remove_clicked(NoClickedToolbarItem);

        //$find(btnYesId).get_events()._removeHandlers(); //20.06.2012 
        //$find(btnNoId).get_events()._removeHandlers();

        $find(btnYesId).add_clicked(x);
        $find(btnNoId).add_clicked(NoClickedToolbarItem);

        $find(btnYesId).focus();

        document.getElementById('lblConfirm').innerHTML = text;

        //Cancel the postback
        args.set_cancel(true);
    }
}

function YesClickedToolbarItem(sender, args, cid, itemvalue) {
    $find(confirmWindowId).close();

    var toolbar = $find(cid);
    if (toolbar !== null) {
        toolbar.get_attributes().setAttribute("DisableConfirm", true);
        toolbar.findItemByValue(itemvalue).click();
        toolbar.get_attributes().removeAttribute("DisableConfirm", true);
    }

}

function NoClickedToolbarItem(sender, args) {
    $find(confirmWindowId).close();
}

Date.prototype.addDays = function (days) {
    var dat = new Date(this.valueOf())
    dat.setDate(dat.getDate() + days);
    return dat;
}


String.prototype.removeTurkishCharacters = function () {
    var string = this;
    var letters = {
        "ı": "i", "ş": "s", "ğ": "g", "ü": "u", "ö": "o", "ç": "c",
        "İ": "I", "Ş": "S", "Ğ": "G", "Ü": "U", "Ö": "O", "Ç": "C"
    };
    return string.replace(/(([ışğüöçIŞĞÜÖÇ]))/g, function (letter) { return letters[letter]; })
}

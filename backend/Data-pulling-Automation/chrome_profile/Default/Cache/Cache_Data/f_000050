var now = new Date();
var specialDays = new Array(
                         { DayNames: ["CHRISTMAS"], Date: new Date(now.getFullYear(), 11, 25) },
                         { DayNames: ["TODAY", "BUGUN"], Date: new Date() },
                         { DayNames: ["TOMORROW", "YARIN"], Date: new Date(now.getFullYear(), now.getMonth(), now.getDate() + 1) },
                         { DayNames: ["YESTERDAY", "DUN"], Date: new Date(now.getFullYear(), now.getMonth(), now.getDate() - 1) },
                         { DayNames: ["FIRST DAY", "AYBASI"], Date: new Date(now.getFullYear(), now.getMonth(), 1) },
                         { DayNames: ["LAST WEEK", "LW", "GECEN HAFTA", "GH"], Date: now.addDays(-7) }
                         );


//this function is used to parse the date entered or selected by the user
function parseDate(sender, e) {
    if (currentDatePicker != null) {
        var date = currentDatePicker.get_dateInput().parseDate(sender.get_value());
        var dateInput = currentDatePicker.get_dateInput();

        if (date == null) {
            var cleanSenderValue = sender.get_value().trim().removeTurkishCharacters().toUpperCase();
            for (var i = 0; i < specialDays.length; i++) {
                if ($.inArray(cleanSenderValue, specialDays[i].DayNames) != -1) {
                    date = specialDays[i].Date;
                    break;
                }
            }
        }

        if (date == null && sender.get_value())
            date = currentDatePicker.get_selectedDate();

        var formattedDate = dateInput.get_dateFormatInfo().FormatDate(date, dateInput.get_displayDateFormat());
        sender.set_value(formattedDate);
    }
}



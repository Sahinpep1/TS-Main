function PrintHtml(htmlData) {
    var styleContent = '<style type="text/css">@media print {hr {display:none;} br { page-break-after: always;}}</style>';
    var metaContent = '<meta http-equiv="X-UA-Compatible" content="IE=edge,chrome=1">';

    var printWindow = window.open('', '_blank', 'height=600,width=700');
    printWindow.document.open();
    printWindow.document.write('<!DOCTYPE html><html><head>' + metaContent + styleContent + '</head><body>' + htmlData + '</body></html>');
    printWindow.document.close();

    printWindow.focus();
    printWindow.print();
    printWindow.close();

    return true;
}


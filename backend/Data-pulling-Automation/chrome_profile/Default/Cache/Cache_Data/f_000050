function numeric_textbox(e) {
    // deal with unicode character sets
    var AKey = 65, aKey = 97, CKey = 67, cKey = 99, VKey = 86, vKey = 118, XKey = 88, xKey = 120;
    var unicode = e.charCode ? e.charCode : e.keyCode;

    if (unicode == 8 || unicode == 9 || (unicode >= 48 && unicode <= 57)) {
        // we allow the key press
        return true;
    } else if (e.ctrlKey && (unicode == AKey || unicode == aKey || unicode == CKey || unicode == cKey || unicode == VKey || unicode == vKey || unicode == XKey || unicode == xKey)) {
        return true;
    } else {
        // otherwise we don't
        return false;
    }
}


function clickButton(e, buttonid) {
    var bt = document.getElementById(buttonid);
    if (typeof bt == 'object') {
        if (navigator.appName.indexOf("Netscape") > (-1)) {
            if (e.keyCode == 13) {
                bt.click();
                return false;
            }
        }
        if (navigator.appName.indexOf("Microsoft Internet Explorer") > (-1)) {
            if (event.keyCode == 13) {
                bt.click();
                return false;
            }
        }
    }
}


    <script type="text/javascript">

        function LoadSystemMessageCount() {
            var notificationIcon = $('#notification-icon');
            var notificationBadge = $('#notification-badge');
            var notificationCount = $('#notification-count');

            notificationIcon.addClass('animated');
            notificationCount.text('Loading...');

            $.ajax({
                type: "POST",
                url: '../API/SystemMessage/GetNewMessageCount/' + $('#hdnIdUser').val(),
                async: true,
                dataType: "json",
                contentType: "application/json; charset=utf-8",
                timeout: 5000
            }).done(function (data) {
                notificationBadge.text(data.UnreadMessageCount);
                notificationCount.text(data.UnreadMessageCount + ' yeni mesajınız var.');

                if (data.UnreadMessageCount)
                    notificationBadge.show(200);
                else
                    notificationBadge.hide();
            }).fail(function (jqXHR, textStatus, errorThrown) {
                //debugger;
                notificationCount.text(textStatus + ": " + jqXHR.responseText);
            }).always(function () {
                notificationIcon.removeClass('animated');
            });
        }

        function LoadSystemMessages() {
            var template = $('#notification-item-template').html();
            var notificationItems = $('#notification-items');
            var notificationLoadingPanel = $('#notification-loading-panel');

            notificationLoadingPanel.show();

            $.ajax({
                type: "POST",
                url: '../API/SystemMessage/GetLastMessages/' + $('#hdnIdUser').val(),
                async: true,
                dataType: "json",
                contentType: "application/json; charset=utf-8",
                timeout: 5000
            }).done(function (data) {

                notificationItems.children('a').remove();
                $.each(data, function () {
                    notificationItems.append(Mustache.to_html(template, this));
                });
            }).fail(function (jqXHR, textStatus, errorThrown) {
                //debugger;
                alert(textStatus + ": " + jqXHR.responseText);
            }).always(function () {
                notificationLoadingPanel.hide('slow');
            });
        }

        $(function () {
            setTimeout(LoadSystemMessageCount, 2000);

            //Catch dropdown shown event
            $("#notification-dropdown").on("show.bs.dropdown", function (event) {
                LoadSystemMessages();
            });

        });

        function OnClientSelectIndexChanging(sender, eventargs) {
            eventargs.set_cancel(true);
